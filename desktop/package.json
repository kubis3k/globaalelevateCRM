{
  "name": "globaal-elevate-work-desktop",
  "version": "1.0.0",
  "description": "Desktopová aplikace Globaal Elevate Work — shell nad work.globaalelevate.com (viz docs/DESKTOP-DESIGN.md).",
  "main": "main.js",
  "author": "Globaal Elevate Production s.r.o.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.globaalelevate.work",
    "productName": "Globaal Elevate Work",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Globaal Elevate Work"
    }
  }
}
